@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Page("/Index", new { area = "" })"
          method="post"
          id="logoutForm">
        <ul class="flex items-center gap-4">
            <li>
                <a class="text-gray-700 hover:text-blue-600" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                    Hello @UserManager.GetUserName(User)!
                </a>
            </li>
            <li>
                <button type="submit" class="text-gray-700 hover:text-red-600">
                    Logout
                </button>
            </li>
        </ul>
    </form>
}
else
{
    <ul class="flex items-center gap-4">
        <li>
            <a class="text-gray-700 hover:text-blue-600" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li>
            <a class="text-gray-700 hover:text-blue-600" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    </ul>
}