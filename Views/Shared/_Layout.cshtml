<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BibliofilAPI</title>
    <script type="importmap"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BibliofilAPI.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="bg-white border-b shadow-sm mb-4">
            <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
                <a class="text-blue-500 text-4xl font-bold" asp-area="" asp-controller="Home" asp-action="Index">BibliofilAPI</a>
                <div class="flex items-center justify-between w-full ml-6">
                    <ul class="flex items-center gap-4">
                        <li>
                            <a class="text-gray-800 hover:text-blue-500" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li>
                            <a class="text-gray-800 hover:text-blue-500" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li>
                            <a class="text-gray-800 hover:text-blue-500" asp-area="" asp-controller="Loans" asp-action="Index">Loans</a>
                        </li>
                        <li>
                            <a class="text-gray-800 hover:text-blue-500" asp-area="" asp-controller="Books" asp-action="Index">Books</a>
                        </li>
                        <li>
                            <a class="text-gray-800 hover:text-blue-500" asp-area="" asp-controller="Users" asp-action="Index">Users</a>
                        </li>
                        
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="max-w-6xl mx-auto px-4">
        <main role="main" class="pb-6">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="max-w-6xl mx-auto px-4">
            &copy; 2026 - BibliofilAPI - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
