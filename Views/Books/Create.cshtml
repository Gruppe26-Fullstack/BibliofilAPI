@model BibliofilAPI.Models.Book

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Book</h4>
<hr />
<div class="flex justify-center">
    <div class="w-full max-w-md">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>
            <div class="mb-4">
                <label asp-for="ISBN" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="ISBN" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="ISBN" class="text-sm text-red-500"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Title" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="Title" class="text-sm text-red-500"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Author" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Author" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="Author" class="text-sm text-red-500"></span>
            </div>
            <div class="mb-4">
                <label asp-for="YearPublished" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="YearPublished" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="YearPublished" class="text-sm text-red-500"></span>
            </div>
            <div class="mb-4">
                <input type="submit" value="Create" class="rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
