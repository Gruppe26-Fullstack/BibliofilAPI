@model IEnumerable<BibliofilAPI.Models.Book>

@{
    ViewData["Title"] = "Index";
}

<h1>Books</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="min-w-full divide-y divide-gray-200 border border-gray-300">
    <thead>
        <tr>
            <th class="px-4 py-2 text-left font-semibold text-gray-700 border-b">
                @Html.DisplayNameFor(model => model.ISBN)
            </th>
            <th class="px-4 py-2 text-left font-semibold text-gray-700 border-b">
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th class="px-4 py-2 text-left font-semibold text-gray-700 border-b">
                @Html.DisplayNameFor(model => model.Author)
            </th>
            <th class="px-4 py-2 text-left font-semibold text-gray-700 border-b">
                @Html.DisplayNameFor(model => model.YearPublished)
            </th>
            <th class="px-4 py-2 text-left font-semibold text-gray-700 border-b"></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="px-4 py-2 border-b">
                @Html.DisplayFor(modelItem => item.ISBN)
            </td>
            <td class="px-4 py-2 border-b">
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td class="px-4 py-2 border-b">
                @Html.DisplayFor(modelItem => item.Author)
            </td>
            <td class="px-4 py-2 border-b">
                @Html.DisplayFor(modelItem => item.YearPublished)
            </td>
            <td class="px-4 py-2 border-b">
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
