@model BibliofilAPI.Models.LibraryUser

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>User</h4>
<hr />
<div class="flex justify-center">
    <div class="w-full max-w-md">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-4">
                <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="FirstName" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="FirstName" class="text-sm text-red-500"></span>
            </div>
            <div class="mb-4">
                <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="LastName" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="LastName" class="text-sm text-red-500"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Email" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="Email" class="text-sm text-red-500"></span>
            </div>
            <div class="mb-4">
                <input type="submit" value="Save" class="rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
